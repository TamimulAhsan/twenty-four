# Built from the workspace root because it imports the generated protobuf module
# and the shared packages, both of which live outside its own directory.
FROM docker.io/library/golang:1.26-alpine AS build
WORKDIR /src

COPY gen/ ./gen/
COPY packages/ ./packages/
COPY services/scheduler/ ./services/scheduler/

# A workspace containing only what this image needs. Reusing the repository's
# go.work would pull in every other service and fail on the ones not copied.
RUN go work init ./gen ./packages ./services/scheduler

RUN go build -trimpath -ldflags="-s -w" -o /out/schedulerd ./services/scheduler/cmd/schedulerd

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/schedulerd /schedulerd
EXPOSE 9116
USER nonroot:nonroot
ENTRYPOINT ["/schedulerd"]
