# POS: registering a sale. Built from the workspace root because it imports the
# generated protobuf module and the shared packages, both of which live outside
# its own directory.
FROM docker.io/library/golang:1.26-alpine AS build
WORKDIR /src

COPY gen/ ./gen/
COPY packages/ ./packages/
COPY services/pos/ ./services/pos/

RUN go work init ./gen ./packages ./services/pos

RUN go build -trimpath -ldflags="-s -w" -o /out/posd ./services/pos/cmd/posd

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/posd /posd
EXPOSE 9108
USER nonroot:nonroot
ENTRYPOINT ["/posd"]
