# Built from the workspace root because it imports the generated protobuf module
# and the shared packages, both of which live outside its own directory.
FROM docker.io/library/golang:1.26-alpine AS build
WORKDIR /src

COPY gen/ ./gen/
COPY packages/ ./packages/
COPY services/tenant/ ./services/tenant/

RUN go work init ./gen ./packages ./services/tenant

RUN go build -trimpath -ldflags="-s -w" -o /out/tenantd ./services/tenant/cmd/tenantd

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/tenantd /tenantd
EXPOSE 9109
USER nonroot:nonroot
ENTRYPOINT ["/tenantd"]
