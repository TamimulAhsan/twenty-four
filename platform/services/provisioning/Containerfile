# Built from the workspace root because it imports the generated protobuf module
# and the shared packages, both of which live outside its own directory.
FROM docker.io/library/golang:1.26-alpine AS build
WORKDIR /src

COPY gen/ ./gen/
COPY packages/ ./packages/
COPY services/provisioning/ ./services/provisioning/

RUN go work init ./gen ./packages ./services/provisioning

RUN go build -trimpath -ldflags="-s -w" -o /out/provisioningd ./services/provisioning/cmd/provisioningd

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/provisioningd /provisioningd
EXPOSE 9110
USER nonroot:nonroot
ENTRYPOINT ["/provisioningd"]
