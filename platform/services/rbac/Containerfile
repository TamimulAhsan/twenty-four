# Roles and permissions. Built from the workspace root because this service imports the
# generated protobuf module, which lives outside its own directory.
FROM docker.io/library/golang:1.26-alpine AS build
WORKDIR /src

COPY gen/ ./gen/
COPY services/rbac/ ./services/rbac/

# A workspace containing only what this image needs. Reusing the repository's
# go.work would pull in every other service and fail on the ones not copied.
RUN go work init ./gen ./services/rbac

RUN go build -trimpath -ldflags="-s -w" -o /out/rbacd ./services/rbac/cmd/rbacd

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/rbacd /rbacd
EXPOSE 9101
USER nonroot:nonroot
ENTRYPOINT ["/rbacd"]
