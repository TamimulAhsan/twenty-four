# Dashboard. Built from the workspace root so the shared packages resolve.
FROM docker.io/library/node:24-alpine AS build
WORKDIR /src

# Manifests first: this layer only rebuilds when a dependency changes, not on
# every source edit.
COPY package.json package-lock.json ./
COPY tsconfig.base.json vitest.config.ts ./
COPY packages/ ./packages/
COPY apps/dashboard/ ./apps/dashboard/
RUN npm ci --no-audit --fund=false
RUN npm run build --workspace @twentyfour/dashboard

FROM docker.io/library/nginx:1.29-alpine
COPY apps/dashboard/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/apps/dashboard/dist/ /usr/share/nginx/html/
EXPOSE 8080
