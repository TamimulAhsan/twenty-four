# Bookings. Built from the workspace root so the shared packages resolve.
FROM docker.io/library/node:24-alpine AS build
WORKDIR /src

# Manifests first: this layer only rebuilds when a dependency changes, not on
# every source edit.
COPY package.json package-lock.json ./
COPY tsconfig.base.json vitest.config.ts ./
COPY packages/ ./packages/
COPY apps/bookings/ ./apps/bookings/
RUN npm ci --no-audit --fund=false
RUN npm run build --workspace @twentyfour/bookings

FROM docker.io/library/nginx:1.29-alpine
COPY apps/bookings/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/apps/bookings/dist/ /usr/share/nginx/html/bookings/
EXPOSE 8080
