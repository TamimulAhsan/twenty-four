# The admin console. Built from the workspace root so the shared packages
# resolve, and served on its own host rather than under the merchant origin.
FROM docker.io/library/node:24-alpine AS build
WORKDIR /src

# Manifests first: this layer only rebuilds when a dependency changes, not on
# every source edit.
COPY package.json package-lock.json ./
COPY tsconfig.base.json vitest.config.ts ./
COPY packages/ ./packages/
COPY apps/admin/ ./apps/admin/
RUN npm ci --no-audit --fund=false
RUN npm run build --workspace @twentyfour/admin

FROM docker.io/library/nginx:1.29-alpine
COPY apps/admin/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/apps/admin/dist/ /usr/share/nginx/html/
EXPOSE 8080
