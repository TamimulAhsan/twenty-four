# Sign in. Built from the workspace root so the shared packages resolve.
FROM docker.io/library/node:24-alpine AS build
WORKDIR /src

# Manifests first: this layer only rebuilds when a dependency changes, not on
# every source edit.
COPY package.json package-lock.json ./
COPY tsconfig.base.json vitest.config.ts ./
COPY packages/ ./packages/
COPY apps/auth/ ./apps/auth/
RUN npm ci --no-audit --fund=false
RUN npm run build --workspace @twentyfour/auth

FROM docker.io/library/nginx:1.29-alpine
COPY apps/auth/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/apps/auth/dist/ /usr/share/nginx/html/auth/
EXPOSE 8080
