{
  "name": "@twentyfour/web",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/tsconfig.json && tsc -p apps/dashboard/tsconfig.json && tsc -p apps/pos/tsconfig.json && tsc -p apps/bookings/tsconfig.json && tsc -p apps/auth/tsconfig.json",
    "dev:dashboard": "npm run dev --workspace @twentyfour/dashboard",
    "build:dashboard": "npm run build --workspace @twentyfour/dashboard",
    "dev:pos": "npm run dev --workspace @twentyfour/pos",
    "build:pos": "npm run build --workspace @twentyfour/pos",
    "dev:bookings": "npm run dev --workspace @twentyfour/bookings",
    "build:bookings": "npm run build --workspace @twentyfour/bookings",
    "dev:auth": "npm run dev --workspace @twentyfour/auth",
    "build:auth": "npm run build --workspace @twentyfour/auth"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.470.0",
    "msw": "^2.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  }
}
