# Tenant API Gateway. Built from the workspace root because it imports the
# generated protobuf module, which lives outside its own directory.
FROM docker.io/library/golang:1.26-alpine AS build
WORKDIR /src

COPY gen/ ./gen/
COPY services/gateway/ ./services/gateway/

# A workspace containing only what this image needs. Reusing the repository's
# go.work would pull in every other service and fail on the ones not copied.
RUN go work init ./gen ./services/gateway

RUN go build -trimpath -ldflags="-s -w" -o /out/gatewayd ./services/gateway/cmd/gatewayd

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/gatewayd /gatewayd
EXPOSE 8081
USER nonroot:nonroot
ENTRYPOINT ["/gatewayd"]
