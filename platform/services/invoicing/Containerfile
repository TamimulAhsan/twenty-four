# Built from the workspace root because it imports the generated protobuf module
# and the shared packages, both of which live outside its own directory.
FROM docker.io/library/golang:1.26-alpine AS build
WORKDIR /src

COPY gen/ ./gen/
COPY packages/ ./packages/
COPY services/invoicing/ ./services/invoicing/

# A workspace containing only what this image needs. Reusing the repository's
# go.work would pull in every other service and fail on the ones not copied.
RUN go work init ./gen ./packages ./services/invoicing

RUN go build -trimpath -ldflags="-s -w" -o /out/invoicingd ./services/invoicing/cmd/invoicingd

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/invoicingd /invoicingd
EXPOSE 9119
USER nonroot:nonroot
ENTRYPOINT ["/invoicingd"]
